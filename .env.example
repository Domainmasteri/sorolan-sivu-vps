PORT=3000
DATABASE_PATH=data/database.sqlite
STYLES_DIR=/opt/sorola/styles

# Generate with: node -e "require('crypto').randomBytes(48).toString('hex')" | head -c 96
JWT_SECRET=

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

BUCKET_NAME=sorola

SITE_URL=https://sorola.fi

SHORTENER_HOME_URL=https://sorola.fi/lyhennin
SHORTENER_ERROR_URL=https://sorola.fi/lyhennin/error
SHORTENER_ALLOWED_ORIGINS=https://sorola.fi,https://soro.la,https://srla.fi,https://srl.la

# OVH DNS API
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
